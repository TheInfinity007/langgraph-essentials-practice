{
  "name": "langgraph-js-essentials",
  "private": true,
  "description": "LangGraph JavaScript/TypeScript tutorial examples",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "npx @langchain/langgraph-cli dev",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.0.0",
    "@langchain/core": "^1.1.33",
    "@langchain/google-vertexai": "^2.3.0",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/langgraph-sdk": "^1.7.4",
    "@langchain/openai": "^1.0.0",
    "uuid": "^14.0.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.1.16",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
